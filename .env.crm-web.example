# Server-only settings for the private website reader. Never use NEXT_PUBLIC_.
# Provisioning writes .env.crm-web.local (ignored, mode 0600); Next does not
# automatically load that custom filename. Load these keys explicitly into the
# server process, or copy them into ignored .env.local (chmod 600 .env.local).
# Production: set these only in the existing Vercel project's server environment.
# This accepts ONLY crm_web for the website project, never crm_agent or postgres.
CRM_WEB_DATABASE_URL=postgresql://crm_web.nydmouxljprsfymcvqko:REPLACE_WITH_PRIVATE_PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres

# Both identity fields are required. The ID stays empty until the matching
# verified production Auth identity has been inspected; never guess a UUID.
CRM_ALLOWED_USER_ID=
CRM_ALLOWED_USER_EMAIL=bing@bingai.studio

# Local alternative: checked CA file. TLS hostname/chain verification is required.
CRM_WEB_DATABASE_CA_FILE=/Users/binggan/new_start/arcane_forge_website/supabase/certs/prod-ca-2021.crt
# Production: prefer CRM_WEB_DATABASE_CA containing the actual complete PEM
# certificate as a multiline runtime value, so deployment file tracing is not
# required. Do not paste a literal backslash-n string into the Vercel value.
# CRM_WEB_DATABASE_CA=
